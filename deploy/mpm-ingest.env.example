# Copy to .env.mpm-ingest at the gateway root; replace placeholders.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=replace-with-broker-user
MQTT_PASSWORD=replace-with-broker-password
MPM_BASE_URL=http://127.0.0.1:8000
MPM_API_KEY=replace-with-company-api-key
# Local operator label only. The API key determines the MPM tenant.
MPM_COMPANY_BINDING=demo-company
BMS_ADAPTER_ID=demo-adapter
BMS_NODE_IDS=53494D0000000001
MPM_HTTP_TIMEOUT_MS=10000
MQTT_RECONNECT_MS=1000
BMS_MAX_PENDING_MESSAGES=100
