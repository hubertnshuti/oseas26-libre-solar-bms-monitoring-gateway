FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app ./app
COPY lib ./lib
COPY deploy/adapter-entrypoint.sh /usr/local/bin/adapter-entrypoint
RUN chmod +x /usr/local/bin/adapter-entrypoint
CMD ["node", "--import", "tsx", "app/mpm-ingest/main.ts"]
